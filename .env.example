# 디스코드 개발자 포털 > Bot > Reset Token 으로 발급한 토큰
DISCORD_TOKEN=여기에_봇_토큰

# (선택) 테스트 서버 ID. 설정하면 그 서버에만 명령어가 즉시 등록됩니다.
# 비워두면 전역 등록(모든 서버, 반영까지 최대 1시간 정도 걸릴 수 있음)
GUILD_ID=

# (선택) 코인 시세 갱신·반대매매 점검 주기(초). 기본 60, 최소 15
TICK_SECONDS=60

# (선택) 장중 종목(주식·ETF·선물·금·환율)의 시세 갱신 주기(초). 기본 180
YAHOO_REFRESH_SECONDS=180

# (선택) 한 틱에 야후에 요청하는 최대 종목 수. 기본 20 (차단되면 줄이세요)
YAHOO_PER_TICK=20

# (선택) 데이터 저장 폴더. 기본 ./data
DATA_DIR=

# (선택) 시세·차트를 가져올 GitHub Pages 주소. 기본: https://ahn493844-cmyk.github.io/discord-stock-bot
PAGES_URL=
